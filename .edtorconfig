# это крневой файл настроен  для своего проекта
# root = true
# правка для всех файлов (*)
[*]
# использовать кодировку UTF-8

charset = utf-8
# использовать пробелы для отступов
ident_style = space
# размер отступа: 4 пробела
ident_seze = 4
# тип = переноса строки: LF (стандарт для Linux/macOS и Git)
end_of_line = lf
# удалять лишние пробелы в конце строк
trim_trailling_whitespace = true
# добалять пустую строку в конце файла
insert_final_newline = true

# особые правила для файлов разметки
[*, (yml, yaml, json, html)]
indent_size = 2
